# Copier ce fichier en .env et remplir au fur et à mesure (jamais de clé dans config.yaml).
# Étape 3 – agent rédacteur : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Secours gratuit : https://console.groq.com/keys
GROQ_API_KEY=
# Étape 5 – validation en un clic : bot créé avec @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Étape 6 – publication : jeton « utilisateur système » de la configuration Meta « API Instagram (connexion unifiée) »
INSTAGRAM_ACCESS_TOKEN=
# Facultatif : trouvé tout seul à partir du jeton
INSTAGRAM_USER_ID=
# Dépôt GitHub PUBLIC qui héberge les images le temps de la publication (ex. pseudo/checkpoint-medias)
MEDIAS_DEPOT=
# Jeton GitHub « fine-grained » limité à ce dépôt, droit Contents en lecture/écriture
MEDIAS_TOKEN=
